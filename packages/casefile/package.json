{
  "name": "@kangyishuai/dsh-casefile",
  "version": "0.0.0",
  "description": "循证逆向工作台：把 REA 的观察变成可引用的证据与可复算的验收",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "evidence",
    "casefile",
    "rea",
    "reverse-engineering"
  ],
  "license": "MIT",
  "author": "nano (https://github.com/kangyishuai)",
  "homepage": "https://github.com/kangyishuai/dsh-plugins/tree/main/packages/casefile#readme",
  "bugs": "https://github.com/kangyishuai/dsh-plugins/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kangyishuai/dsh-plugins.git",
    "directory": "packages/casefile"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "locale",
    "README.md",
    "README.zh-CN.md",
    "DISCLAIMER.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
