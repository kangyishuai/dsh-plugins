{
  "name": "@kangyishuai/dsh-artifacts",
  "version": "0.2.2",
  "description": "Local deliverable pages for DSH sessions: publish, preview live, keep versions",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "license": "MIT",
  "author": "nano (https://github.com/kangyishuai)",
  "homepage": "https://github.com/kangyishuai/dsh-plugins/tree/main/packages/artifacts#readme",
  "bugs": "https://github.com/kangyishuai/dsh-plugins/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kangyishuai/dsh-plugins.git",
    "directory": "packages/artifacts"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
