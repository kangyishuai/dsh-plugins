{
  "name": "dsh-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "Unofficial, end-to-end verified plugins for DeepSeek Harness (DSH): in-place conversation rewind with file restore, real session deletion with trash + audit log, decision cards, and an on-demand advisor.",
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=22.19.0"
  },
  "author": "nano (https://github.com/kangyishuai)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kangyishuai/dsh-plugins.git"
  },
  "scripts": {
    "advisor:review": "node scripts/advisor-review.mjs",
    "changeset": "changeset",
    "check": "node scripts/check-plugins.mjs && node scripts/build-index.mjs --check",
    "check:docs": "node scripts/check-docs.mjs",
    "check:index": "node scripts/build-index.mjs --check",
    "check:public": "node scripts/check-public.mjs",
    "format": "biome check --write .",
    "gate": "node scripts/gate.mjs",
    "gate:advisor": "node scripts/gate.mjs advisor",
    "gate:next-step": "node scripts/gate.mjs next-step",
    "gate:session-delete": "node scripts/gate.mjs session-delete",
    "gate:session-rewind": "node scripts/gate.mjs session-rewind",
    "index": "node scripts/build-index.mjs",
    "lint": "biome check .",
    "list-plugins": "node scripts/list-plugins.mjs",
    "new": "node scripts/new-plugin.mjs",
    "prepare": "simple-git-hooks",
    "probe:runtime": "node scripts/probe-runtime.mjs",
    "release": "pnpm verify && node scripts/publish.mjs",
    "shots:session-rewind": "node scripts/readme-shots-session-rewind.mjs",
    "smoke:advisor": "node scripts/smoke-advisor.mjs",
    "smoke:advisor-desktop": "node scripts/smoke-advisor-desktop.mjs",
    "smoke:agent-tool": "node scripts/smoke-agent-tool.mjs",
    "smoke:artifacts": "node scripts/smoke-artifacts.mjs",
    "smoke:artifacts-desktop": "node scripts/smoke-artifacts-desktop.mjs",
    "smoke:index": "node scripts/smoke-index.mjs",
    "smoke:next-step": "node scripts/smoke-next-step.mjs",
    "smoke:next-step-desktop": "node scripts/smoke-next-step-desktop.mjs",
    "smoke:session-delete": "node scripts/smoke-session-delete.mjs",
    "smoke:session-delete-desktop": "node scripts/smoke-session-delete-desktop.mjs",
    "smoke:session-rewind": "node scripts/smoke-session-rewind.mjs",
    "smoke:session-rewind-desktop": "node scripts/smoke-session-rewind-desktop.mjs",
    "test": "node --test \"scripts/test/**/*.test.js\" && pnpm -r --if-present test",
    "tokens:host": "node scripts/host-tokens.mjs",
    "tokens:host:check": "node scripts/host-tokens.mjs --check",
    "typecheck": "tsc -p .",
    "verify": "pnpm lint && pnpm typecheck && pnpm check && pnpm check:docs && pnpm check:public && pnpm test",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "wt": "node scripts/worktree.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && node scripts/check-public.mjs",
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "lint-staged": {
    "*.{js,mjs,json,jsonc,md,yml,yaml}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^22.20.5",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2"
  }
}
