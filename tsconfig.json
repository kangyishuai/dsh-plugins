{
  // 只做类型检查，不产出任何文件。源码是带 JSDoc 的纯 JS（见 AGENTS.md：不引入打包器）。
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    // 交给 Biome 检查：TS 会把 client 半 factory(require) 里的 require("x") 当成 import，误报参数未使用
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "types/**/*.d.ts",
    "packages/*/lib/**/*.js",
    "packages/*/test/**/*.js",
    "templates/**/*.js",
    "scripts/**/*.mjs",
    "*.config.mjs"
  ],
  "exclude": ["**/node_modules"]
}
